## Define Some Helper Functions

```elixir
defmodule Helper do
  def download!(url, save_as) do
    unless File.exists?(save_as) do
      Req.get!(url, http_errors: :raise, into: File.stream!(save_as))
    end

    :ok
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, Helper, <<70, 79, 82, 49, 0, 0, 10, ...>>, {:download!, 3}}
```

## Write the Detection Module

The model is OpenCV's ONNX export of TensorFlow's `ssd_mobilenet_v2_coco_2018_03_29`. It takes a 300x300 RGB `uint8` image in NHWC layout and returns four tensors: normalized `{y1, x1, y2, x2}` boxes, scores, 1-based COCO class ids, and the number of detections.

```elixir
# change to the file's directory
# or somewhere you have write permission
File.cd!(__DIR__)

defmodule SSDMobileNetV2 do
  @model_url "https://huggingface.co/opencv/opencv_contribution/resolve/main/ssd_mobilenet_v2_coco_2018_03_29/ssd_mobilenet_v2_coco_2018_03_29_2026jul.onnx?download=true"
  @labels_url "https://raw.githubusercontent.com/cocoa-xu/evision/main/test/testdata/models/coco_names.txt"
  @out_names [
    "detection_boxes:0",
    "detection_scores:0",
    "detection_classes:0",
    "num_detections:0"
  ]

  def load do
    Helper.download!(@model_url, "ssd_mobilenet_v2_coco_2018_03_29.onnx")
    Helper.download!(@labels_url, "coco_names.txt")

    net = Evision.DNN.readNet("ssd_mobilenet_v2_coco_2018_03_29.onnx")
    labels = "coco_names.txt" |> File.read!() |> String.split("\n")
    {net, labels}
  end

  def detect({net, labels}, image, confidence_threshold \\ 0.5) do
    {h, w, _} = image.shape

    input =
      image
      |> Evision.cvtColor(Evision.Constant.cv_COLOR_BGR2RGB())
      |> Evision.resize({300, 300})
      |> Evision.Mat.to_binary()
      |> Evision.Mat.from_binary_by_shape({:u, 8}, {1, 300, 300, 3})

    [boxes, scores, classes, count] =
      net
      |> Evision.DNN.Net.setInput(input)
      |> Evision.DNN.Net.forward(outBlobNames: @out_names)
      |> Enum.map(&Evision.Mat.to_nx(&1, Nx.BinaryBackend))

    count = count |> Nx.to_flat_list() |> hd() |> trunc()
    boxes = boxes |> Nx.reshape({:auto, 4}) |> Nx.to_list()

    [boxes, Nx.to_flat_list(scores), Nx.to_flat_list(classes)]
    |> Enum.zip()
    |> Enum.take(count)
    |> Enum.filter(fn {_box, score, _class} -> score > confidence_threshold end)
    |> Enum.map(fn {[y1, x1, y2, x2], score, class} ->
      {Enum.at(labels, trunc(class) - 1), score,
       {trunc(x1 * w), trunc(y1 * h), trunc(x2 * w), trunc(y2 * h)}}
    end)
  end

  def draw(image, detections) do
    Enum.reduce(detections, image, fn {label, score, {l, t, r, b}}, image ->
      text = "#{label}: #{Float.round(score, 2)}"

      image
      |> Evision.rectangle({l, t}, {r, b}, {255, 0, 0}, thickness: 2)
      |> Evision.putText(
        text,
        {l, max(t - 5, 12)},
        Evision.Constant.cv_FONT_HERSHEY_SIMPLEX(),
        0.5,
        {0, 0, 255}
      )
    end)
  end
end
```

