```

## Detect Objects in An Image

```elixir
Helper.download!(
  "https://raw.githubusercontent.com/cocoa-xu/evision/main/test/testdata/dnn_detection_test.jpg",
  "dnn_detection_test.jpg"
)

model = SSDMobileNetV2.load()
image = Evision.imread("dnn_detection_test.jpg")
detections = SSDMobileNetV2.detect(model, image)
```

<!-- livebook:{"output":true} -->

```
[
  {"car", 0.9736444354057312, {464, 205, 602, 339}},
  {"car", 0.8993234634399414, {280, 214, 480, 352}},
  {"car", 0.882705807685852, {557, 208, 803, 364}},
  {"car", 0.6523396968841553, {765, 198, 872, 350}},
  {"person", 0.5624266862869263, {157, 133, 301, 372}},
  {"car", 0.5576940774917603, {99, 162, 212, 316}}
]
```

```elixir
image
|> SSDMobileNetV2.draw(detections)
|> then(&Evision.imencode(".png", &1))
|> Kino.Image.new(:png)
```

## Detect Objects in a Video Stream

```elixir
# if you have a camera available
# uncomment the line below
# video = Evision.VideoCapture.videoCapture(0)

# or the OpenCV library you compiled can decode video files
# uncomment the line below
# video = Evision.VideoCapture.videoCapture("/path/to/your/video/file")
```

<!-- livebook:{"output":true} -->

```
nil
```

```elixir
defmodule VideoDetection do
  def detect(video, widget, max_frames \\ 30 * 60) when is_integer(max_frames) do
    loop(SSDMobileNetV2.load(), video, widget, max_frames)
  end

  defp loop(_model, _video, _widget, 0), do: :ok

  defp loop(model, video, widget, frames_left) do
    case Evision.VideoCapture.read(video) do
      %Evision.Mat{} = frame ->
        frame
        |> SSDMobileNetV2.draw(SSDMobileNetV2.detect(model, frame))
        |> then(&Evision.imencode(".png", &1))
        |> Kino.Image.new(:png)
        |> then(&Kino.Frame.render(widget, &1))

        loop(model, video, widget, frames_left - 1)

      _ ->
        :ok
    end
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, VideoDetection, <<70, 79, 82, 49, 0, 0, 12, ...>>, {:loop, 4}}
```

### Run the detection

```elixir
widget = Kino.Frame.new() |> Kino.render()
# read 1,800 frames at most
# change the number to negative values to
# detect objects until OpenCV cannot read
# new frame from the video stream
VideoDetection.detect(video, widget, 1800)
```

<!-- livebook:{"output":true} -->

```
:ok
```
